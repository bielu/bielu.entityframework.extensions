<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <RootNamespace>Bielu.EntityFramework.Extensions.Versioning.Benchmarks</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="BenchmarkDotNet" />
      <PackageReference Include="BenchmarkDotNet.Diagnostics.dotMemory" />
      <PackageReference Include="Microsoft.EntityFrameworkCore" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Bielu.EntityFramework.Extensions.Versioning\Bielu.EntityFramework.Extensions.Versioning.csproj" />
      <ProjectReference Include="..\Bielu.EntityFramework.Extensions.Versioning.Abstractions\Bielu.EntityFramework.Extensions.Versioning.Abstractions.csproj" />
    </ItemGroup>

</Project>
